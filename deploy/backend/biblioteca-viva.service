[Unit]
Description=Biblioteca Viva Spring Boot API
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=biblioteca
Group=biblioteca
WorkingDirectory=/opt/biblioteca-viva
EnvironmentFile=/etc/biblioteca-viva/backend.env
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do (echo > /dev/tcp/127.0.0.1/5432) >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/bin/java -jar /opt/biblioteca-viva/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
