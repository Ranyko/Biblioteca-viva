{
  "info": {
    "name": "Biblioteca Viva — Sprint 2 (backend H4–H8)",
    "description": "Complemento H4–H8. Executar na ordem com API/banco locais. leitorId deve apontar para leitor ativo e abaixo do limite; padrão 2 do seed. Não exportar tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "leitorId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "autorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoriaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "livroId",
      "value": "",
      "type": "string"
    },
    {
      "key": "exemplarId",
      "value": "",
      "type": "string"
    },
    {
      "key": "emprestimoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tituloTeste",
      "value": "",
      "type": "string"
    },
    {
      "key": "tomboTeste",
      "value": "",
      "type": "string"
    },
    {
      "key": "isbnTeste",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Sprint 2 — backend H4–H8",
      "item": [
        {
          "name": "01 Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@biblioteca.com\",\n  \"senha\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = String(Date.now());",
                  "pm.collectionVariables.set(\"tituloTeste\",\"Obra teste \"+s);",
                  "pm.collectionVariables.set(\"tomboTeste\",\"H5-\"+s);",
                  "pm.collectionVariables.set(\"isbnTeste\",s.padStart(13,\"0\").slice(-13));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "pm.collectionVariables.set(\"adminToken\",pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 H4 criar autor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/autores",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Autor de teste\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "pm.collectionVariables.set(\"autorId\",pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 H4 criar categoria",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/categorias",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Categoria {{tomboTeste}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "pm.collectionVariables.set(\"categoriaId\",pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 H4 criar livro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/livros",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"titulo\":\"{{tituloTeste}}\",\"isbn\":\"{{isbnTeste}}\",\"anoPublicacao\":2026,\"ativo\":true,\"autorIds\":[{{autorId}}],\"categoriaIds\":[{{categoriaId}}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "pm.collectionVariables.set(\"livroId\",pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 H4 ISBN duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/livros",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"titulo\":\"{{tituloTeste}}\",\"isbn\":\"{{isbnTeste}}\",\"anoPublicacao\":2026,\"ativo\":true,\"autorIds\":[{{autorId}}],\"categoriaIds\":[{{categoriaId}}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });",
                  "if (pm.response.code === 409) {",
                  "",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "06 H4 CT04 ISBN ausente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/livros",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Livro sem ISBN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "if (pm.response.code === 400) {",
                  "",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "07 H5 criar exemplar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/exemplares",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"livroId\":{{livroId}},\"codigoTombo\":\"{{tomboTeste}}\",\"estadoConservacao\":\"bom\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "const r=pm.response.json(); pm.collectionVariables.set(\"exemplarId\",r.id); pm.test(\"Inicial disponível\",()=>pm.expect(r.status).to.eql(\"disponivel\"));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "08 H5 tombo duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/exemplares",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"livroId\":{{livroId}},\"codigoTombo\":\"{{tomboTeste}}\",\"estadoConservacao\":\"bom\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });",
                  "if (pm.response.code === 409) {",
                  "",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "09 H6 pesquisar obra nova",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/acervo?titulo={{tituloTeste}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "pm.test(\"Uma obra e exemplar disponível\",()=>{ const r=pm.response.json(); pm.expect(r.total).to.eql(1); pm.expect(r.itens[0].exemplaresDisponiveis).to.eql(1); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "10 H7 emprestar exemplar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/atendente/emprestimos",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"leitorId\":{{leitorId}},\"exemplarId\":{{exemplarId}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "pm.collectionVariables.set(\"emprestimoId\",pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "11 H5 não inativar exemplar emprestado",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/exemplares/{{exemplarId}}/situacao",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ativo\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });",
                  "if (pm.response.code === 409) {",
                  "",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "12 H8 devolver no prazo",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/atendente/emprestimos/{{emprestimoId}}/devolucao",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "pm.test(\"Sem multa e disponível\",()=>{ const r=pm.response.json(); pm.expect(r.valorMulta).to.eql(0); pm.expect(r.statusExemplar).to.eql(\"disponivel\"); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "13 H8 devolução repetida recusada",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/atendente/emprestimos/{{emprestimoId}}/devolucao",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });",
                  "if (pm.response.code === 409) {",
                  "",
                  "}"
